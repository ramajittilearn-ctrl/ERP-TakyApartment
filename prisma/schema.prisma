generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum RoomStatus {
  AVAILABLE
  MAINTENANCE
  RESERVED
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

enum MeterKind {
  WATER
  ELECTRICITY
}

enum ExpenseKind {
  OPEX
  CAPEX
}

enum ExpenseStatus {
  PENDING
  POSTED
  CANCELLED
  REVERSED
}

enum ExpenseMethod {
  CASH
  BANK_TRANSFER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REVERSED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum DepositKind {
  RECEIVED
  REFUNDED
  DEDUCTED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum BackupStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum BillingPeriodStatus {
  OPEN
  CLOSED
}

enum MeterReadingStatus {
  DRAFT
  CONFIRMED
}

enum MeterReadingType {
  OPENING
  NORMAL
  FINAL
}

model Property {
  id             String             @id @default(uuid()) @db.Uuid
  code           String             @unique @db.VarChar(40)
  name           String             @db.VarChar(160)
  address        String             @default("") @db.VarChar(500)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  duePolicy      PropertyDuePolicy?
  floors         Floor[]
  rates          UtilityRate[]
  expenses       Expense[]
  billingPeriods BillingPeriod[]
}

model Floor {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  number     Int
  name       String   @db.VarChar(80)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  rooms      Room[]

  @@unique([propertyId, number])
}

model Room {
  id                String               @id @default(uuid()) @db.Uuid
  floorId           String               @db.Uuid
  floor             Floor                @relation(fields: [floorId], references: [id], onDelete: Restrict)
  number            String               @db.VarChar(12)
  rent              Decimal              @db.Decimal(14, 2)
  status            RoomStatus           @default(AVAILABLE)
  notes             String               @default("") @db.VarChar(1000)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  leases            Lease[]
  meters            UtilityMeter[]
  meterReplacements MeterReplacement[]
  maintenance       MaintenanceRequest[]
  frozenLeases      BillingFreezeLease[]

  @@unique([floorId, number])
  @@index([status])
}

model Tenant {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @db.VarChar(160)
  phone        String               @default("") @db.VarChar(40)
  email        String               @default("") @db.VarChar(254)
  address      String               @default("") @db.VarChar(500)
  notes        String               @default("") @db.VarChar(1000)
  isDemo       Boolean              @default(false)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)
  leases       Lease[]
  attachments  Attachment[]
  frozenLeases BillingFreezeLease[]

  @@index([name])
}

model Lease {
  id                          String                       @id @default(uuid()) @db.Uuid
  number                      String                       @unique @db.VarChar(40)
  roomId                      String                       @db.Uuid
  tenantId                    String                       @db.Uuid
  room                        Room                         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  startDate                   DateTime                     @db.Date
  endDate                     DateTime                     @db.Date
  rent                        Decimal                      @db.Decimal(14, 2)
  deposit                     Decimal                      @db.Decimal(14, 2)
  status                      LeaseStatus                  @default(DRAFT)
  isDemo                      Boolean                      @default(false)
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(3)
  deposits                    SecurityDeposit[]
  invoices                    Invoice[]
  payments                    Payment[]
  attachments                 Attachment[]
  frozenLeases                BillingFreezeLease[]
  billingConsumptionApprovals BillingConsumptionApproval[]

  @@index([roomId, status])
  @@index([tenantId])
  @@index([endDate])
}

model SecurityDeposit {
  id         String      @id @default(uuid()) @db.Uuid
  leaseId    String      @db.Uuid
  lease      Lease       @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  kind       DepositKind
  amount     Decimal     @db.Decimal(14, 2)
  occurredAt DateTime    @db.Timestamptz(3)
  isDemo     Boolean     @default(false)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)

  @@index([leaseId, occurredAt])
}

model UtilityMeter {
  id               String             @id @default(uuid()) @db.Uuid
  roomId           String             @db.Uuid
  room             Room               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  kind             MeterKind
  serial           String             @db.VarChar(80)
  activeFrom       DateTime?          @db.Date
  activeUntil      DateTime?          @db.Date
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  readings         MeterReading[]
  replacementAsOld MeterReplacement[] @relation("ReplacementOldMeter")
  replacementAsNew MeterReplacement[] @relation("ReplacementNewMeter")

  @@unique([roomId, kind, serial])
  @@index([roomId, kind, activeFrom, activeUntil])
}

model MeterReading {
  id                    String                   @id @default(uuid()) @db.Uuid
  meterId               String                   @db.Uuid
  meter                 UtilityMeter             @relation(fields: [meterId], references: [id], onDelete: Restrict)
  period                DateTime                 @db.Date
  billingPeriodId       String?                  @db.Uuid
  billingPeriod         BillingPeriod?           @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict)
  readingDate           DateTime?                @db.Date
  value                 Decimal                  @db.Decimal(14, 3)
  consumption           Decimal?                 @db.Decimal(14, 3)
  status                MeterReadingStatus       @default(CONFIRMED)
  type                  MeterReadingType         @default(NORMAL)
  previousReadingId     String?                  @db.Uuid
  previousReading       MeterReading?            @relation("ReadingPredecessor", fields: [previousReadingId], references: [id], onDelete: Restrict)
  nextReadings          MeterReading[]           @relation("ReadingPredecessor")
  recordedById          String                   @db.Uuid
  recordedBy            User                     @relation("MeterReadingRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  confirmedById         String?                  @db.Uuid
  confirmedBy           User?                    @relation("MeterReadingConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt           DateTime?                @db.Timestamptz(3)
  isDemo                Boolean                  @default(false)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)
  corrections           MeterReadingCorrection[]
  finalForReplacement   MeterReplacement?        @relation("ReplacementFinalReading")
  initialForReplacement MeterReplacement?        @relation("ReplacementInitialReading")

  @@unique([meterId, billingPeriodId])
  @@index([meterId, period])
  @@index([recordedById])
  @@index([confirmedById])
  @@index([billingPeriodId, status])
  @@index([previousReadingId])
}

model MeterReadingCorrection {
  id             String       @id @default(uuid()) @db.Uuid
  readingId      String       @db.Uuid
  reading        MeterReading @relation(fields: [readingId], references: [id], onDelete: Restrict)
  oldValue       Decimal      @db.Decimal(14, 3)
  newValue       Decimal      @db.Decimal(14, 3)
  oldConsumption Decimal?     @db.Decimal(14, 3)
  newConsumption Decimal?     @db.Decimal(14, 3)
  reason         String       @db.VarChar(1000)
  correctedById  String       @db.Uuid
  correctedBy    User         @relation(fields: [correctedById], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([readingId, createdAt])
  @@index([correctedById])
}

model MeterReplacement {
  id               String       @id @default(uuid()) @db.Uuid
  roomId           String       @db.Uuid
  room             Room         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  kind             MeterKind
  oldMeterId       String       @db.Uuid
  oldMeter         UtilityMeter @relation("ReplacementOldMeter", fields: [oldMeterId], references: [id], onDelete: Restrict)
  newMeterId       String       @db.Uuid
  newMeter         UtilityMeter @relation("ReplacementNewMeter", fields: [newMeterId], references: [id], onDelete: Restrict)
  finalReadingId   String       @unique @db.Uuid
  finalReading     MeterReading @relation("ReplacementFinalReading", fields: [finalReadingId], references: [id], onDelete: Restrict)
  initialReadingId String       @unique @db.Uuid
  initialReading   MeterReading @relation("ReplacementInitialReading", fields: [initialReadingId], references: [id], onDelete: Restrict)
  replacementDate  DateTime     @db.Date
  reason           String       @db.VarChar(1000)
  replacedById     String       @db.Uuid
  replacedBy       User         @relation(fields: [replacedById], references: [id], onDelete: Restrict)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([oldMeterId])
  @@unique([newMeterId])
  @@index([roomId, kind, replacementDate])
  @@index([replacedById])
}

model UtilityRate {
  id                String                 @id @default(uuid()) @db.Uuid
  propertyId        String                 @db.Uuid
  property          Property               @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  kind              MeterKind
  unitPrice         Decimal                @db.Decimal(14, 4)
  effectiveFrom     DateTime               @db.Date
  createdById       String?                @db.Uuid
  createdBy         User?                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  billingSelections BillingRateSelection[]

  @@unique([propertyId, kind, effectiveFrom])
  @@index([createdById])
}

model BillingPeriod {
  id                   String                       @id @default(uuid()) @db.Uuid
  propertyId           String                       @db.Uuid
  property             Property                     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  startsOn             DateTime                     @db.Date
  endsOn               DateTime                     @db.Date
  status               BillingPeriodStatus          @default(OPEN)
  closedAt             DateTime?                    @db.Timestamptz(3)
  createdById          String                       @db.Uuid
  createdBy            User                         @relation("BillingPeriodCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  closedById           String?                      @db.Uuid
  closedBy             User?                        @relation("BillingPeriodClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  createdAt            DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(3)
  meterReadings        MeterReading[]
  rateSelections       BillingRateSelection[]
  freeze               BillingPeriodFreeze?
  invoices             Invoice[]
  consumptionApprovals BillingConsumptionApproval[]

  @@unique([propertyId, startsOn])
  @@index([propertyId, status, startsOn])
  @@index([createdById])
  @@index([closedById])
}

model BillingRateSelection {
  id              String        @id @default(uuid()) @db.Uuid
  billingPeriodId String        @db.Uuid
  billingPeriod   BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict)
  kind            MeterKind
  utilityRateId   String        @db.Uuid
  utilityRate     UtilityRate   @relation(fields: [utilityRateId], references: [id], onDelete: Restrict)
  revision        Int
  reason          String        @db.VarChar(1000)
  approvedById    String        @db.Uuid
  approvedBy      User          @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([billingPeriodId, kind, revision])
  @@index([utilityRateId])
  @@index([approvedById])
}

model BillingConsumptionApproval {
  id              String        @id @default(uuid()) @db.Uuid
  billingPeriodId String        @db.Uuid
  billingPeriod   BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict)
  leaseId         String        @db.Uuid
  leaseVersion    String?       @db.VarChar(40)
  lease           Lease         @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  kind            MeterKind
  revision        Int
  sourceData      Json
  approvedById    String        @db.Uuid
  approvedBy      User          @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([billingPeriodId, leaseId, kind, revision], map: "BillingConsumptionApproval_billingPeriodId_leaseId_kind_revisio")
  @@index([leaseId])
  @@index([approvedById])
}

model Invoice {
  id          String              @id @default(uuid()) @db.Uuid
  number      String?             @unique @db.VarChar(40)
  leaseId     String              @db.Uuid
  lease       Lease               @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  period      DateTime            @db.Date
  dueDate     DateTime?           @db.Date
  status      InvoiceStatus       @default(DRAFT)
  issuedAt    DateTime?           @db.Timestamptz(3)
  isDemo      Boolean             @default(false)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  items       InvoiceItem[]
  allocations PaymentAllocation[]

  billingPeriodId   String?             @db.Uuid
  billingPeriod     BillingPeriod?      @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict)
  frozenLeaseId     String?             @db.Uuid
  frozenLease       BillingFreezeLease? @relation(fields: [frozenLeaseId], references: [id], onDelete: Restrict)
  correctionId      String?             @unique @db.Uuid
  correction        InvoiceCorrection?  @relation("UsedCorrection", fields: [correctionId], references: [id], onDelete: Restrict)
  corrections       InvoiceCorrection[] @relation("OriginalInvoice")
  previousInvoiceId String?             @unique @db.Uuid
  previousInvoice   Invoice?            @relation("InvoiceRevision", fields: [previousInvoiceId], references: [id], onDelete: Restrict)
  nextInvoice       Invoice?            @relation("InvoiceRevision")
  revision          Int                 @default(1)
  version           Int                 @default(1)
  finalTotal        Decimal?            @db.Decimal(14, 2)
  snapshot          Json?
  fingerprint       String?             @db.Char(64)
  dueProvenance     Json?
  notes             String              @default("") @db.VarChar(2000)
  issuedById        String?             @db.Uuid
  voidedById        String?             @db.Uuid
  voidedAt          DateTime?           @db.Timestamptz(3)
  voidReason        String?             @db.VarChar(1000)
  issuedBy          User?               @relation("InvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  voidedBy          User?               @relation("InvoiceVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@unique([leaseId, billingPeriodId, revision])
  @@index([billingPeriodId, status])
  @@index([status, dueDate])
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  description String   @db.VarChar(200)
  quantity    Decimal  @db.Decimal(17, 3)
  unitPrice   Decimal  @db.Decimal(16, 4)
  amount      Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([invoiceId])
}

model Payment {
  id          String              @id @default(uuid()) @db.Uuid
  reference   String              @unique @db.VarChar(100)
  leaseId     String              @db.Uuid
  lease       Lease               @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  amount      Decimal             @db.Decimal(14, 2)
  method      String              @db.VarChar(30)
  status      PaymentStatus       @default(PENDING)
  receivedAt  DateTime            @db.Timestamptz(3)
  isDemo      Boolean             @default(false)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  allocations PaymentAllocation[]
  attachments Attachment[]

  methodCode          PaymentMethod?
  legacyUnmapped      Boolean          @default(true)
  version             Int              @default(1)
  recordedById        String?          @db.Uuid
  confirmedById       String?          @db.Uuid
  confirmedAt         DateTime?        @db.Timestamptz(3)
  reversedAt          DateTime?        @db.Timestamptz(3)
  cancelledAt         DateTime?        @db.Timestamptz(3)
  cancelledById       String?          @db.Uuid
  cancelReason        String?          @db.VarChar(1000)
  externalReference   String?          @db.VarChar(120)
  receivingAccountKey String?          @db.VarChar(80)
  recordedBy          User?            @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  confirmedBy         User?            @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  cancelledBy         User?            @relation("PaymentCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  reversal            PaymentReversal?
  receipt             Receipt?

  @@index([leaseId])
  @@index([status, receivedAt])
}

model PaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @db.Uuid
  invoiceId String   @db.Uuid
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model ExpenseCategory {
  createdById String?     @db.Uuid
  createdBy   User?       @relation("ExpenseCategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  changedById String?     @db.Uuid
  changedBy   User?       @relation("ExpenseCategoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  active      Boolean     @default(true)
  version     Int         @default(1)
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique @db.VarChar(100)
  kind        ExpenseKind
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  expenses    Expense[]
}

model Expense {
  legacyUnmapped       Boolean         @default(true)
  status               ExpenseStatus?
  version              Int?
  vendor               String?         @db.VarChar(120)
  method               ExpenseMethod?
  note                 String?         @db.VarChar(500)
  categoryNameSnapshot String?         @db.VarChar(100)
  categoryKindSnapshot ExpenseKind?
  recordedById         String?         @db.Uuid
  recordedBy           User?           @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  postedById           String?         @db.Uuid
  postedBy             User?           @relation("ExpensePostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  postedAt             DateTime?       @db.Timestamptz(3)
  cancelledById        String?         @db.Uuid
  cancelledBy          User?           @relation("ExpenseCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledAt          DateTime?       @db.Timestamptz(3)
  cancelReason         String?         @db.VarChar(1000)
  reversedById         String?         @db.Uuid
  reversedBy           User?           @relation("ExpenseReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reversedAt           DateTime?       @db.Timestamptz(3)
  reverseReason        String?         @db.VarChar(1000)
  correctionOfId       String?         @db.Uuid
  correctionOf         Expense?        @relation("ExpenseCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections          Expense[]       @relation("ExpenseCorrection")
  id                   String          @id @default(uuid()) @db.Uuid
  propertyId           String          @db.Uuid
  property             Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  categoryId           String          @db.Uuid
  category             ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description          String          @db.VarChar(200)
  amount               Decimal         @db.Decimal(14, 2)
  occurredAt           DateTime        @db.Date
  isDemo               Boolean         @default(false)
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)
  attachments          Attachment[]

  @@index([propertyId, occurredAt])
  @@index([categoryId])
}

model ExpenseCommand {
  id                 String   @id @default(uuid()) @db.Uuid
  actorId            String   @db.Uuid
  actor              User     @relation("ExpenseCommandActor", fields: [actorId], references: [id], onDelete: Restrict)
  commandKey         String   @db.VarChar(100)
  operation          String   @db.VarChar(80)
  requestFingerprint String   @db.Char(64)
  result             Json
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@unique([actorId, commandKey])
}

model MaintenanceRequest {
  id          String            @id @default(uuid()) @db.Uuid
  roomId      String            @db.Uuid
  room        Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  description String            @db.VarChar(2000)
  priority    Int               @default(2)
  status      MaintenanceStatus @default(OPEN)
  assigneeId  String?           @db.Uuid
  assignee    User?             @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  isDemo      Boolean           @default(false)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@index([roomId, status])
  @@index([assigneeId])
}

model User {
  id                          String                       @id @default(uuid()) @db.Uuid
  username                    String                       @unique @db.VarChar(80)
  email                       String                       @unique @db.VarChar(254)
  name                        String                       @db.VarChar(160)
  passwordHash                String
  role                        Role                         @default(STAFF)
  disabled                    Boolean                      @default(false)
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(3)
  sessions                    Session[]
  audits                      AuditLog[]
  readingsRecorded            MeterReading[]               @relation("MeterReadingRecordedBy")
  readingsConfirmed           MeterReading[]               @relation("MeterReadingConfirmedBy")
  readingCorrections          MeterReadingCorrection[]
  meterReplacements           MeterReplacement[]
  maintenance                 MaintenanceRequest[]
  attachments                 Attachment[]
  backups                     BackupHistory[]
  utilityRates                UtilityRate[]
  billingPeriodsCreated       BillingPeriod[]              @relation("BillingPeriodCreatedBy")
  billingPeriodsClosed        BillingPeriod[]              @relation("BillingPeriodClosedBy")
  billingRateSelections       BillingRateSelection[]
  billingConsumptionApprovals BillingConsumptionApproval[]
  FreezeClosedBy              BillingPeriodFreeze[]        @relation("FreezeClosedBy")
  CorrectionApprovedBy        InvoiceCorrection[]          @relation("CorrectionApprovedBy")
  InvoiceCommandActor         InvoiceCommand[]             @relation("InvoiceCommandActor")
  DuePolicyConfiguredBy       PropertyDuePolicy[]          @relation("DuePolicyConfiguredBy")
  InvoiceIssuedBy             Invoice[]                    @relation("InvoiceIssuedBy")
  InvoiceVoidedBy             Invoice[]                    @relation("InvoiceVoidedBy")
  paymentsRecorded            Payment[]                    @relation("PaymentRecordedBy")
  paymentsConfirmed           Payment[]                    @relation("PaymentConfirmedBy")
  paymentsCancelled           Payment[]                    @relation("PaymentCancelledBy")
  paymentsReversed            PaymentReversal[]            @relation("PaymentReversedBy")
  receiptsIssued              Receipt[]                    @relation("ReceiptIssuedBy")
  receiptsCancelled           ReceiptCancellation[]        @relation("ReceiptCancelledBy")
  paymentCommands             PaymentCommand[]             @relation("PaymentCommandActor")
  expenseRecorded             Expense[]                    @relation("ExpenseRecordedBy")
  expensePosted               Expense[]                    @relation("ExpensePostedBy")
  expenseCancelled            Expense[]                    @relation("ExpenseCancelledBy")
  expenseReversed             Expense[]                    @relation("ExpenseReversedBy")
  expenseCategoriesCreated    ExpenseCategory[]            @relation("ExpenseCategoryCreatedBy")
  expenseCategoriesChanged    ExpenseCategory[]            @relation("ExpenseCategoryChangedBy")
  expenseCommands             ExpenseCommand[]             @relation("ExpenseCommandActor")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.Char(64)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model LoginThrottle {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.Char(64)
  attempts    Int      @default(0)
  windowStart DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([windowStart])
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  storageKey   String   @unique @db.VarChar(200)
  originalName String   @db.VarChar(200)
  mimeType     String   @db.VarChar(100)
  bytes        BigInt
  sha256       String   @db.Char(64)
  uploadedById String   @db.Uuid
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  tenantId     String?  @db.Uuid
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  leaseId      String?  @db.Uuid
  lease        Lease?   @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  paymentId    String?  @db.Uuid
  payment      Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  expenseId    String?  @db.Uuid
  expense      Expense? @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([uploadedById])
  @@index([tenantId])
  @@index([leaseId])
  @@index([paymentId])
  @@index([expenseId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(40)
  entityId  String?  @db.Uuid
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

model BackupHistory {
  id            String       @id @default(uuid()) @db.Uuid
  initiatedById String?      @db.Uuid
  initiatedBy   User?        @relation(fields: [initiatedById], references: [id], onDelete: Restrict)
  status        BackupStatus
  storageKey    String?      @db.VarChar(200)
  checksum      String?      @db.Char(64)
  bytes         BigInt?
  error         String?      @db.VarChar(1000)
  verifiedAt    DateTime?    @db.Timestamptz(3)
  uploadedAt    DateTime?    @db.Timestamptz(3)
  kind          String       @default("manual") @db.VarChar(20)
  finishedAt    DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  @@index([initiatedById])
  @@index([status, createdAt])
}

model BillingPeriodFreeze {
  id              String               @id @default(uuid()) @db.Uuid
  billingPeriodId String               @unique @db.Uuid
  billingPeriod   BillingPeriod        @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict)
  schemaVersion   String               @db.VarChar(20)
  closedById      String               @db.Uuid
  closedAt        DateTime             @db.Timestamptz(3)
  leaseCount      Int
  fingerprint     String               @db.Char(64)
  leases          BillingFreezeLease[]
  closedBy        User                 @relation("FreezeClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
}

model BillingFreezeLease {
  id          String              @id @default(uuid()) @db.Uuid
  freezeId    String              @db.Uuid
  freeze      BillingPeriodFreeze @relation(fields: [freezeId], references: [id], onDelete: Restrict)
  leaseId     String              @db.Uuid
  lease       Lease               @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  room        Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roomId      String              @db.Uuid
  tenantId    String              @db.Uuid
  labels      Json
  snapshot    Json
  fingerprint String              @db.Char(64)
  invoices    Invoice[]
  corrections InvoiceCorrection[]

  @@unique([freezeId, leaseId])
  @@index([leaseId])
}

model InvoiceCorrection {
  id                String             @id @default(uuid()) @db.Uuid
  originalInvoiceId String             @db.Uuid
  originalInvoice   Invoice            @relation("OriginalInvoice", fields: [originalInvoiceId], references: [id], onDelete: Restrict)
  frozenLeaseId     String             @db.Uuid
  frozenLease       BillingFreezeLease @relation(fields: [frozenLeaseId], references: [id], onDelete: Restrict)
  approvedById      String             @db.Uuid
  approvedAt        DateTime           @default(now()) @db.Timestamptz(3)
  reason            String             @db.VarChar(1000)
  evidence          Json
  snapshot          Json
  fingerprint       String             @db.Char(64)
  differences       Json
  invoice           Invoice?           @relation("UsedCorrection")
  approvedBy        User               @relation("CorrectionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([frozenLeaseId, approvedAt])
}

model InvoiceMonthCounter {
  month String @id @db.Char(6)
  value Int
}

model PropertyDuePolicy {
  propertyId     String   @id @db.Uuid
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  offsetDays     Int
  version        Int
  configuredById String   @db.Uuid
  configuredAt   DateTime @default(now()) @db.Timestamptz(3)
  configuredBy   User     @relation("DuePolicyConfiguredBy", fields: [configuredById], references: [id], onDelete: Restrict)
}

model InvoiceCommand {
  id                 String   @id @default(uuid()) @db.Uuid
  actorId            String   @db.Uuid
  commandKey         String   @db.VarChar(100)
  operation          String   @db.VarChar(40)
  requestFingerprint String   @db.Char(64)
  result             Json
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  actor              User     @relation("InvoiceCommandActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, commandKey])
}

model PaymentReversal {
  id                  String               @id @default(uuid()) @db.Uuid
  paymentId           String               @unique @db.Uuid
  payment             Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reason              String               @db.VarChar(1000)
  actorId             String               @db.Uuid
  actor               User                 @relation("PaymentReversedBy", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  receiptCancellation ReceiptCancellation?
}

model Receipt {
  id              String               @id @default(uuid()) @db.Uuid
  number          String               @unique @db.VarChar(40)
  paymentId       String               @unique @db.Uuid
  payment         Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  issuedAt        DateTime             @db.Timestamptz(3)
  issuedById      String               @db.Uuid
  issuedBy        User                 @relation("ReceiptIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  snapshotVersion String               @db.VarChar(20)
  snapshot        Json
  fingerprint     String               @db.Char(64)
  cancellation    ReceiptCancellation?
}

model ReceiptCancellation {
  id         String          @id @default(uuid()) @db.Uuid
  receiptId  String          @unique @db.Uuid
  receipt    Receipt         @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  reversalId String          @unique @db.Uuid
  reversal   PaymentReversal @relation(fields: [reversalId], references: [id], onDelete: Restrict)
  reason     String          @db.VarChar(1000)
  actorId    String          @db.Uuid
  actor      User            @relation("ReceiptCancelledBy", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
}

model PaymentCommand {
  id                 String   @id @default(uuid()) @db.Uuid
  actorId            String   @db.Uuid
  actor              User     @relation("PaymentCommandActor", fields: [actorId], references: [id], onDelete: Restrict)
  commandKey         String   @db.VarChar(100)
  operation          String   @db.VarChar(40)
  requestFingerprint String   @db.Char(64)
  result             Json
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@unique([actorId, commandKey])
}

model ReceiptMonthCounter {
  month String @id @db.Char(6)
  value Int
}
