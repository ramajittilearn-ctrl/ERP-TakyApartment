# Generate a private .env with: node scripts/configure.mjs
POSTGRES_DB=taky
POSTGRES_USER=taky
POSTGRES_PASSWORD=
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:3000
APP_BIND_IP=127.0.0.1
APP_PORT=3000
SESSION_SECRET=
COOKIE_SECURE=false
ATTACHMENT_DIR=/app/storage/attachments

# Phase 2.5: node scripts/ops.mjs init creates private .local/operations.env.
# Use scripts/ops.mjs up so the HTTPS and operations overlays are applied.
# The generated operations file contains these non-secret settings/secret paths:
# LAN_HOST=192.168.1.50
# APP_BIND_IP=192.168.1.50
# HTTPS_PORT=443
# BACKUP_DIR=/absolute/private/local/backups
# BACKUP_KEY_PATH=/absolute/private/local/backup.key
# RCLONE_CONFIG_DIR=/absolute/private/local/rclone
# BACKUP_REMOTE=gdrive:TakyApartmentBackups
# Never put encryption keys, OAuth tokens or TLS private keys in this example.
