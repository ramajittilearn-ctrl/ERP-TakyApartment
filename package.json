{
  "name": "taky-apartment-erp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:setup": "tsx scripts/admin.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests prisma scripts operations *.ts *.mjs --no-warn-ignored --max-warnings 0",
    "test:ops": "node --test tests/ops/*.test.mjs",
    "ops": "node scripts/ops.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:screenshots": "playwright test --grep 'responsive smoke'",
    "screenshots:gallery": "node scripts/make-screenshot-gallery.mjs",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'tests/**/*.ts' '*.ts' package.json tsconfig.json postcss.config.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.8",
    "lucide-react": "^0.577.0",
    "next": "16.4.1",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.13.0",
    "prettier": "3.9.10",
    "prisma": "^7.10.1",
    "serve": "^14.2.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
